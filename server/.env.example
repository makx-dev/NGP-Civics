PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/ngp-civics
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Initial Admin Seed Credentials
ADMIN_NAME="NGP Civics Authority"
ADMIN_EMAIL=admin@nmcnagpur.gov.in
ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_DEPARTMENT=Authority

# MongoDB Keep-Alive / Ping Configuration
MONGO_PING_INTERVAL_MINUTES=5
MONGO_PING_LOGS=true
